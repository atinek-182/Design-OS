{
  "$schema": "https://design-os.antigravity.dev/schemas/tokens.v1.json",
  "version": "1.0.0",
  "colorSpace": "oklch",
  "palette": {
    "background": {
      "base": "oklch(0.12 0.015 260)",
      "surface": "oklch(0.16 0.02 260)",
      "elevated": "oklch(0.20 0.025 260)",
      "subtle": "oklch(0.14 0.018 260)"
    },
    "text": {
      "primary": "oklch(0.98 0.005 260)",
      "secondary": "oklch(0.72 0.02 260)",
      "muted": "oklch(0.52 0.02 260)",
      "inverse": "oklch(0.10 0.01 260)"
    },
    "brand": {
      "primary": "oklch(0.65 0.22 260)",
      "hover": "oklch(0.70 0.24 260)",
      "active": "oklch(0.60 0.20 260)",
      "subtle": "oklch(0.22 0.06 260)"
    },
    "border": {
      "subtle": "oklch(0.24 0.02 260 / 0.4)",
      "strong": "oklch(0.35 0.03 260 / 0.6)",
      "active": "oklch(0.65 0.22 260 / 0.8)"
    }
  },
  "contrastFloor": {
    "wcagStandard": "2.2 AA",
    "textOnBackground": 12.4,
    "secondaryOnBackground": 5.8,
    "brandOnBackground": 4.6,
    "uiComponentsMin": 3.1
  },
  "typography": {
    "fontDisplay": "'Space Grotesk', 'Inter', sans-serif",
    "fontBody": "'Inter', -apple-system, sans-serif",
    "fontMono": "'JetBrains Mono', monospace",
    "fluidScale": {
      "hero": "clamp(2.5rem, 5vw + 1rem, 5.5rem)",
      "h1": "clamp(2rem, 3.5vw + 0.8rem, 3.75rem)",
      "h2": "clamp(1.5rem, 2.5vw + 0.5rem, 2.75rem)",
      "h3": "clamp(1.25rem, 1.5vw + 0.5rem, 1.875rem)",
      "bodyLarge": "1.125rem",
      "body": "1rem",
      "caption": "0.875rem",
      "monoBadge": "0.75rem"
    },
    "lineHeight": {
      "tight": "1.1",
      "snug": "1.25",
      "normal": "1.5",
      "relaxed": "1.7"
    }
  },
  "elevation": {
    "shadowSm": "0 1px 2px oklch(0 0 0 / 0.25)",
    "shadowMd": "0 4px 12px oklch(0 0 0 / 0.35), 0 0 0 1px oklch(1 0 0 / 0.05)",
    "shadowLg": "0 12px 32px oklch(0 0 0 / 0.45), 0 0 0 1px oklch(1 0 0 / 0.08)",
    "glassBlur": "blur(16px) saturate(180%)"
  },
  "radii": {
    "sm": "6px",
    "md": "12px",
    "lg": "18px",
    "xl": "24px",
    "full": "9999px"
  }
}
